{
  "name": "payment-system-integration-tests",
  "version": "1.0.0",
  "description": "Integration tests for the payment and credits system",
  "type": "module",
  "scripts": {
    "test": "node run-tests.js",
    "test:all": "node run-tests.js",
    "test:packages": "node run-tests.js --feature=universal-packages",
    "test:credits": "node run-tests.js --feature=credit-system",
    "test:subscriptions": "node run-tests.js --feature=subscription-billing",
    "test:events": "node run-tests.js --feature=events",
    "test:events:creation": "node run-single-test.js event-creation",
    "test:events:booking": "node run-single-test.js event-booking",
    "test:events:credits": "node run-single-test.js event-credits",
    "test:events:capacity": "node run-single-test.js event-capacity",
    "test:events:cancellation": "node run-single-test.js event-cancellation",
    "test:events:comprehensive": "node run-cancellation-tests.js",
    "test:events:all": "npm run test:events:creation && npm run test:events:booking && npm run test:events:credits && npm run test:events:capacity && npm run test:events:cancellation && npm run test:events:comprehensive",
    "test:notifications": "node run-tests.js --feature=notifications",
    "test:notifications:creation": "node run-single-test.js notification-creation",
    "test:notifications:delivery": "node run-single-test.js notification-delivery",
    "test:notifications:preferences": "node run-single-test.js notification-preferences",
    "test:notifications:templates": "node run-single-test.js notification-templates",
    "test:notifications:broadcast": "node run-single-test.js notification-broadcast",
    "test:notifications:security": "node run-single-test.js notification-security",
    "test:notifications:delivery-comprehensive": "node run-single-test.js notification-delivery-comprehensive",
    "test:notifications:integration": "node run-single-test.js notification-integration",
    "test:notifications:all": "npm run test:notifications:creation && npm run test:notifications:delivery && npm run test:notifications:preferences && npm run test:notifications:templates && npm run test:notifications:broadcast && npm run test:notifications:security && npm run test:notifications:integration",
    "test:notifications:comprehensive": "npm run test:notifications:delivery-comprehensive",
    "test:cancellation": "node run-cancellation-tests.js",
    "test:webhooks": "node run-tests.js --feature=webhook-processing",
    "test:errors": "node run-tests.js --feature=error-handling",
    "test:verbose": "node run-tests.js --verbose",
    "cleanup": "node utils/cleanup.js",
    "debug": "node --inspect-brk run-tests.js",
    "debug:events": "node --inspect-brk test-events-only.js",
    "debug:capacity": "node --inspect-brk debug-single-test.js event-capacity",
    "debug:booking": "node --inspect-brk debug-single-test.js event-booking",
    "debug:credits": "node --inspect-brk debug-single-test.js event-credits",
    "debug:cleanup": "node --inspect-brk test-improved-cleanup.js",
    "debug:setup": "node --inspect-brk test-debug-setup.js",
    "debug:watch": "nodemon --inspect-brk run-tests.js --feature=events"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "chalk": "^5.3.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
